# Copy to frontend/.env.local to change these locally. Do not commit real secrets.

# "true" (the default) serves demo data from src/api/mock so the dashboard works
# before the backend API exists. Set to "false" to call the real backend.
VITE_USE_MOCKS=true

# Where the browser sends API and health requests. These paths are proxied by
# Vite (see vite.config.js) to the backend and AI-engine services.
VITE_API_BASE_URL=/backend-api
VITE_AI_API_BASE_URL=/ai-api
